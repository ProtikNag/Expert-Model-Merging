# ── Byte-compiled / build artifacts ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.Python

# ── Virtualenvs ────────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Editor / OS detritus ───────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ── HuggingFace & torch caches (sometimes written inside repo) ─────────
.cache/
.hf_cache/

# ── Data and large artifacts (never commit) ────────────────────────────
data/
checkpoints/
*.pt
# allow tiny demo tensors in docs
!docs/*.pt
*.bin
*.safetensors
*.ckpt

# ── Run-specific logs and per-run metrics (regenerated each run) ───────
results/logs/
# populated only on GPU runs
results/glue/
results/smoke/checkpoints/

# Allow the small smoke-test outputs that document the pipeline works,
# but strip anything that can be regenerated trivially.
results/smoke/*/cache/

# ── Notebook checkpoints ───────────────────────────────────────────────
.ipynb_checkpoints/
# SLURM job artifacts
job*.out
job*.err

# Heavy run artifacts not tracked in git
checkpoints/
results/logs/

# ── Secrets (never commit) ─────────────────────────────────────────────
hf_token.txt
*.token

# ── MergeBench Tier 0/1/2 outputs (regenerated on HPC) ─────────────────
# NOTE: git does NOT strip inline (trailing) comments. A pattern written as
# "mb_merged/  # note" is taken literally and matches nothing, so keep every
# comment on its own line.
mb_ckpts/
mb_merged/
mb_fisher/
# anchored to repo root: matches the top-level clone only, NOT results/mergebench/
# (macOS is case-insensitive, so an unanchored "MergeBench/" also hits "mergebench")
/MergeBench/
results/mb_eval/
# results/mergebench/ holds the tracked .md result tables AND regenerated
# artifacts; ignore only the artifacts so the tables stay versioned.
results/mergebench/*.json
results/mergebench/*.html
results/mergebench/*.pdf
results/mergebench/figures/
